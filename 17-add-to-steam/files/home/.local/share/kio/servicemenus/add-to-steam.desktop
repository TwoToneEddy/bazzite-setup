[Desktop Entry]
Type=Service
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;application/x-executable;application/vnd.appimage;application/x-shellscript;application/x-desktop;
Actions=addToSteam
X-KDE-Priority=TopLevel

[Desktop Action addToSteam]
Name=Add to Steam
Icon=steam
Exec=/usr/bin/steamos-add-to-steam -ui %f
