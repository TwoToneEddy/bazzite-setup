#!/usr/bin/env bash
#
# steam-gaming - start Steam with ~/.config/gaming-env.conf applied.
#
# Steam passes its own environment down to every game it launches, so putting
# the MangoHud and DLSS switches here is what makes them apply everywhere
# without per-game launch options. The Steam launcher (steam.desktop in
# ~/.local/share/applications) runs this instead of bazzite-steam (or steam) directly.
#
# Anything in the conf file wins over what is already in the environment;
# that is deliberate, so `dlss` has the last word.
set -u

CONF="${HOME}/.config/environment.d/95-gaming.conf"

if [ -f "$CONF" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONF"
    set +a
fi

# The DLSS indicator is set in each prefix's registry by `dlss overlay`. If this
# variable is absent, GE-Proton fills in "DLSSIndicator=0,..." (a setdefault in
# its proton script) and DXVK-NVAPI writes that over the registry at every game
# launch. Set but empty, GE-Proton leaves it alone and nothing is written.
export DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS=

# Bazzite wraps Steam in bazzite-steam; everywhere else (CachyOS) it is plain steam.
if [ -x /usr/bin/bazzite-steam ]; then exec /usr/bin/bazzite-steam "$@"; fi
exec steam "$@"
