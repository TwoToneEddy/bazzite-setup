#!/usr/bin/env bash
#
# dlss - the DLSS debug indicator for every Proton game, and the gaming
# environment's status. DLSS presets are not set here: RHI does that.
#
#   dlss status                 Show what is set right now.
#   dlss overlay <on|off>       The DLSS / DLSS-G debug indicator overlay.
#   dlss dlls                   Open DLSS Updater (swap the DLL versions).
#
# How this works: Proton's NVAPI shim (DXVK-NVAPI) passes NGX debug options to
# the game from an environment variable. It is written into
# ~/.config/environment.d/95-gaming.conf, which systemd exports to the whole
# session (so the autostarted Steam gets them too) and
# which ~/.local/bin/steam-gaming also re-applies - so fully quit
# Steam and start it again for a change to reach your games.
#
# The DLL versions themselves are a separate job: `dlss dlls` opens DLSS
# Updater, which swaps nvngx_dlss*.dll inside each game.
#
set -uo pipefail

# The real file lives in environment.d so that systemd's user session exports
# it to EVERYTHING - including the Steam that KDE autostarts at login, which
# does not go through any launcher we control. ~/.config/gaming-env.conf is a
# symlink here for convenience; write to the real path, because the temp-file
# rename below would otherwise replace the symlink with a regular file.
CONF="${HOME}/.config/environment.d/95-gaming.conf"
BEGIN="# BEGIN DLSS"
END="# END DLSS"

die()  { printf '%s\n' "$*" >&2; exit 1; }

[ -f "$CONF" ] || die "$CONF does not exist. Was the gaming setup installed?"
grep -q "^${BEGIN}\$" "$CONF" || die "$CONF has no '$BEGIN' marker."

# --- reading and writing the managed block ------------------------------------
block()      { sed -n "/^${BEGIN}\$/,/^${END}\$/p" "$CONF" | sed '1d;$d'; }
get()        { block | grep "^$1=" | tail -1 | cut -d= -f2-; }

set_var() {  # set_var NAME VALUE   (empty VALUE removes the line)
    local name="$1" value="${2:-}" tmp
    tmp=$(mktemp)
    awk -v b="$BEGIN" -v e="$END" -v n="$name" -v v="$value" '
        $0==b { print; inblk=1; next }
        $0==e { if (v != "") print n "=" v; print; inblk=0; next }
        inblk && $0 ~ "^" n "=" { next }
        { print }
    ' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
}

restart_hint() {
    # Push the change into the running session too, so anything started from
    # now on picks it up without waiting for a re-login.
    systemctl --user daemon-reload 2>/dev/null || true
    printf '\nFully quit Steam and start it again for this to reach your games.\n'
}

# --- commands -----------------------------------------------------------------
cmd_status() {
    printf 'DLSS (global, applied to every Proton game)\n\n'
    printf '  Presets            not managed here - RHI sets them\n'
    local ovl; ovl=$(get DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS)
    case "$ovl" in
        *DLSSIndicator=1024*) printf '  Debug overlay      on\n' ;;
        *DLSSIndicator=0*)    printf '  Debug overlay      off\n' ;;
        *)                    printf '  Debug overlay      not set\n' ;;
    esac
    printf '\n  DLSS DLL upgrade   %s\n' \
        "$(grep -q '^PROTON_DLSS_UPGRADE=1' "$CONF" && echo 'on (Proton pulls the newest DLLs)' || echo off)"
    printf '  MangoHud overlay   %s\n' \
        "$(grep -q '^MANGOHUD=1' "$CONF" && echo "on ('/' toggles it)" || echo off)"
    printf '\n  Config: %s\n' "$CONF"
}

cmd_overlay() {
    case "${1:-toggle}" in
        on)
            # 1024 is the DLSS indicator, 2 the DLSS-G one. NGX reads these
            # from the Wine registry, so DXVK-NVAPI writes them there for us.
            set_var DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS "DLSSIndicator=1024,DLSSGIndicator=2"
            printf 'DLSS debug overlay -> on\n' ;;
        off)
            # It has to be written as zero, not removed: the values live in the
            # prefix registry, so dropping the variable leaves the last write
            # in place and the overlay stays on.
            set_var DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS "DLSSIndicator=0,DLSSGIndicator=0"
            printf 'DLSS debug overlay -> off\n'
            printf '(Leave this set for one run of each game so the zero reaches its registry.)\n' ;;
        status)
            cmd_status | grep 'Debug overlay'; return 0 ;;
        toggle)
            case "$(get DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS)" in
                *DLSSIndicator=1024*) cmd_overlay off; return ;;
                *) cmd_overlay on; return ;;
            esac ;;
        *) die "usage: dlss overlay <on|off|status>" ;;
    esac
    restart_hint
}

cmd_dlls() {
    command -v flatpak >/dev/null || die "flatpak not found."
    flatpak info io.github.recol.dlss-updater >/dev/null 2>&1 \
        || die "DLSS Updater is not installed."
    printf 'Opening DLSS Updater (Games -> pick a title -> update or roll back its DLLs).\n'
    setsid flatpak run io.github.recol.dlss-updater >/dev/null 2>&1 &
}

case "${1:-status}" in
    status)            cmd_status ;;
    overlay)           cmd_overlay "${2:-toggle}" ;;
    dlls|dll|versions) cmd_dlls ;;
    sr|rr|mfg|fg|launch-options|reset)
                       die "DLSS presets are set with RHI now, not with dlss." ;;
    -h|--help|help)    sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "Unknown command '$1'. Try: dlss help" ;;
esac
