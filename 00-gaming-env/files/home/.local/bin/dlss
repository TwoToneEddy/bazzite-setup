#!/usr/bin/env bash
#
# dlss - the DLSS debug indicator for every Proton game, and the gaming
# environment's status. DLSS presets and DLL versions are not set here: RHI
# does that.
#
#   dlss status                 Show what is set right now.
#   dlss overlay <on|off>       The DLSS / DLSS-G debug indicator overlay.
#   dlss hook-system            Hook system-installed Proton (sudo), see below.
#
# How this works: NGX reads the indicator from the registry when a game starts
# DLSS - HKLM\SOFTWARE\NVIDIA Corporation\Global\NGXCore, ShowDlssIndicator and
# DLSSG_IndicatorText - exactly as on Windows. Under Proton each game has its own
# registry, in its prefix, so `dlss overlay` writes the values into every
# prefix's system.reg directly. No Steam restart: the next launch of each game
# sees the change. A game that is running at the time is skipped (Wine would
# write its own copy back over the edit on exit); toggle again once it is closed.
#
# The chosen state is kept in ~/.config/dlss-overlay so that prefixes that do
# not exist yet can be brought into line by the next toggle.
#
# GE-Proton 11 overrides the registry: unless PROTON_DLSS_INDICATOR is set it
# exports DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS=DLSSIndicator=0,... and dxvk-nvapi
# writes that over these values at every launch. So each GE-Proton install also
# gets a user_settings.py that reads ~/.config/dlss-overlay at launch and sets
# PROTON_DLSS_INDICATOR to match. A newly installed GE-Proton gets it at the
# next `dlss overlay` (or `dlss status`). Proton installed by a system package
# (Proton-CachyOS, in /usr/share/steam/compatibilitytools.d) behaves the same but
# is root-owned, so it is hooked once by `dlss hook-system`; the hook reads the
# state file at launch, so toggling never needs root.
#
set -uo pipefail

CONF="${HOME}/.config/environment.d/95-gaming.conf"
STATE="${HOME}/.config/dlss-overlay"
STEAM="${HOME}/.local/share/Steam"

die()  { printf '%s\n' "$*" >&2; exit 1; }

state() { cat "$STATE" 2>/dev/null || echo off; }

# Every compatdata/<appid>/pfx in every Steam library.
prefixes() {
    { printf '%s\n' "$STEAM"
      sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"$/\1/p' \
          "$STEAM/steamapps/libraryfolders.vdf" 2>/dev/null
    } | while read -r lib; do readlink -f "$lib"; done | sort -u | while read -r lib; do
        for p in "$lib"/steamapps/compatdata/*/pfx; do
            [ -f "$p/system.reg" ] && printf '%s\n' "$p"
        done
    done
}

# Prefixes with a wineserver running, i.e. a game open in them right now.
running_prefixes() {
    local pid
    for pid in $(pgrep -x wineserver); do
        tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null |
            sed -n 's/^WINEPREFIX=//p' | while read -r p; do readlink -f "$p"; done
    done
}

# set_reg <pfx> <indicator> <dlssg>  - set both values, adding the key if needed.
set_reg() {
    python3 - "$1/system.reg" "$2" "$3" <<'PY'
import os, sys, time
path, ind, dlssg = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
key = "[Software\\\\NVIDIA Corporation\\\\Global\\\\NGXCore]"
want = {"ShowDlssIndicator": ind, "DLSSG_IndicatorText": dlssg}
lines = open(path, encoding="utf-8", errors="surrogateescape").read().split("\n")
start = next((i for i, l in enumerate(lines) if l.startswith(key + " ")), None)
if start is None:
    lines += [f"{key} {int(time.time())}", "#time=0"] + \
             [f'"{k}"=dword:{v:08x}' for k, v in want.items()] + [""]
else:
    end = start + 1
    while end < len(lines) and lines[end].strip():
        end += 1
    body = [l for l in lines[start + 1:end]
            if not any(l.startswith(f'"{k}"=') for k in want)]
    body += [f'"{k}"=dword:{v:08x}' for k, v in want.items()]
    lines[start + 1:end] = body
tmp = path + ".dlss-tmp"
open(tmp, "w", encoding="utf-8", errors="surrogateescape").write("\n".join(lines))
os.replace(tmp, path)
PY
}

# user_settings.py for every GE-Proton install. One we did not write is left alone.
GE_MARK="# written by dlss (bazzite-setup)"
# Proton builds installed by a system package (Proton-CachyOS lives here) do the
# same as GE-Proton, but are root-owned: `dlss hook-system` hooks them, with sudo.
SYSTEM_TOOLS=(/usr/share/steam/compatibilitytools.d /usr/local/share/steam/compatibilitytools.d)

hook_body() {
    cat <<PY
$GE_MARK - read at every launch; keeps the DLSS indicator
# in step with ~/.config/dlss-overlay. See: dlss help
import os
try:
    _on = open(os.path.expanduser("~/.config/dlss-overlay")).read().strip() == "on"
except OSError:
    _on = False
user_settings = {"PROTON_DLSS_INDICATOR": "1" if _on else "0"}
PY
}

# System Proton installs whose user_settings.py is missing or out of date.
unhooked_system() {
    local t d f
    for t in "${SYSTEM_TOOLS[@]}"; do for d in "$t"/*/; do
        [ -f "$d/proton" ] || continue
        f="$d/user_settings.py"
        if [ -e "$f" ] && ! grep -qF "$GE_MARK" "$f"; then
            printf 'Not touching %s: it is not ours. Set PROTON_DLSS_INDICATOR in it by hand.\n' "$f" >&2
            continue
        fi
        [ -e "$f" ] && [ "$(cat "$f")" = "$(hook_body)" ] || printf '%s\n' "${d%/}"
    done; done
}

ge_hook() {
    local d f missing
    for d in "$STEAM"/compatibilitytools.d/*/; do
        [ -f "$d/proton" ] || continue
        f="$d/user_settings.py"
        if [ -e "$f" ] && ! grep -qF "$GE_MARK" "$f"; then
            printf 'Not touching %s: it is not ours. Set PROTON_DLSS_INDICATOR in it by hand.\n' "$f" >&2
            continue
        fi
        hook_body > "$f"
    done
    missing=$(unhooked_system 2>/dev/null)
    [ -z "$missing" ] ||
        printf '!! System Proton not hooked, the overlay toggle has no effect there:\n%s\n   Fix: dlss hook-system  (uses sudo)\n' \
            "$(printf '%s\n' "$missing" | sed 's/^/     /')" >&2
}

cmd_hook_system() {
    local d todo
    todo=$(unhooked_system)
    [ -n "$todo" ] || { printf 'Every system Proton is already hooked.\n'; return 0; }
    while read -r d; do
        if hook_body | sudo tee "$d/user_settings.py" >/dev/null &&
            sudo chmod 644 "$d/user_settings.py"; then
            printf 'hooked  %s\n' "$d"
        else
            printf 'FAILED  %s\n' "$d" >&2; return 1
        fi
    done <<< "$todo"
}

apply_state() {  # apply_state on|off
    local ind=0 dlssg=0 p run n=0 skipped=()
    [ "$1" = on ] && { ind=1024; dlssg=2; }   # 1024 = DLSS indicator, 2 = DLSS-G
    run=$(running_prefixes)
    while read -r p; do
        [ -n "$p" ] || continue
        if printf '%s\n' "$run" | grep -qxF "$p"; then
            skipped+=("$(basename "$(dirname "$p")")"); continue
        fi
        set_reg "$p" "$ind" "$dlssg" && n=$((n + 1))
    done < <(prefixes)
    printf '%s\n' "$1" > "$STATE"
    ge_hook
    printf 'DLSS debug overlay -> %s (%d prefixes; applies the next time each game starts)\n' "$1" "$n"
    [ ${#skipped[@]} -eq 0 ] ||
        printf 'Skipped, game running: app %s - toggle again after closing it.\n' "${skipped[*]}"
}

# --- commands -----------------------------------------------------------------
cmd_status() {
    ge_hook
    printf 'DLSS (global, applied to every Proton game)\n\n'
    printf '  Presets and DLLs   not managed here - RHI sets them\n'
    printf '  Debug overlay      %s\n' "$(state)"
    grep -q '^DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS=' "$CONF" 2>/dev/null &&
        printf '  !! DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS is still set in %s;\n     it overrides the registry at every launch. Remove it.\n' "$CONF"
    printf '\n  MangoHud overlay   %s\n' \
        "$(grep -q '^MANGOHUD=1' "$CONF" && echo "on ('/' toggles it)" || echo off)"
    printf '\n  State: %s\n' "$STATE"
}

cmd_overlay() {
    case "${1:-toggle}" in
        on|off) apply_state "$1" ;;
        status) printf 'Debug overlay      %s\n' "$(state)" ;;
        toggle) if [ "$(state)" = on ]; then apply_state off; else apply_state on; fi ;;
        *) die "usage: dlss overlay <on|off|status>" ;;
    esac
}

case "${1:-status}" in
    status)            cmd_status ;;
    overlay)           cmd_overlay "${2:-toggle}" ;;
    hook-system)       cmd_hook_system ;;
    sr|rr|mfg|fg|launch-options|reset|dlls|dll|versions)
                       die "DLSS presets and DLLs are set with RHI now, not with dlss." ;;
    -h|--help|help)    sed -n '3,31p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "Unknown command '$1'. Try: dlss help" ;;
esac
