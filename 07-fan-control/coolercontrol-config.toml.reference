# This is the CoolerControl configuration file.
# Comments and most formatting is preserved.
# Most of this file you can edit by hand, but it is recommended to stop the daemon when doing so.
# -------------------------------


# Unique ID Device List
# -------------------------------
# This is a simple UID and device name key-value pair, that is automatically generated at startup
#  to help humans distinguish which UID belongs to which device in this config file.
#  Only the device name is given here, complete Device information can be requested from the API.
#  UIDs are generated sha256 hashes based on specific criteria to help determine device uniqueness.
# ANY CHANGES WILL BE OVERWRITTEN.
# Example:
# 21091c4fb341ceab6236e8c9e905ccc263a4ac08134b036ed415925ba4c1645d = "Nvidia GPU"
[devices]
f20695849442dea0fbdd7f28643d6c135e403b8455cc30dce0b715076bda38d6 = "spd5118"
03c24b814ec48cbdc3b7dbe40da379677c97da6f722211839b41ac2f01133f8d = "nvme0"
b6d02588487877ec3238ea90ec100fdbb64c4a4bd72a37fcaf8961bbe9f9741f = "NVIDIA GeForce RTX 5090"
0f68164f4541772691ad12b9717556082fa9bba5953946cdb722a3cebe382f8e = "spd5118"
81f5ad7fc3410ff9a747a485d4cff254701eec76726a7c9dbd7e6860541db532 = "amdgpu"
70711400826330c360a625dfe588d97b470984fcf84f2895343f765f03d8d803 = "nvme1"
3145e1a42801faf9cf948df8c705afb4859f084c10a7e7c5e4efecb1e0167127 = "AMD Ryzen 7 9800X3D 8-Core Processor"
82070f1426a25351dd629a4d0ad1c5b51944236224eb4872763e99aa4808abec = "r8169_0_500:00"
4918af169e08d2fd42d3623dd3054933a5c772ba41b11d19abea089b9161853b = "nct6799"
19e098e312e1b1b39163a343ea22b6ea17f18ec1a803ffe0ce44f5bacd6076ee = "Custom Sensors"


# Legacy690 Option for devices
# -------------------------------
# There are 2 Asetek 690LC liquid coolers that have the same device ID.
#  To tell them apart we need user input to know which cooler we're actually dealing with.
#  This is an assignment of liquidctl AseTek690LC device UIDs to true/false:
#   true = Legacy690 Cooler aka NZXT Kraken X40, X60, X31, X41, X51 and X61
#   false = Modern690 Cooler aka EVGA CLC 120 (CLC12), 240, 280 and 360
# Example:
# 21091c4fb341ceab6236e8c9e905ccc263a4ac08134b036ed415925ba4c1645d = true
[legacy690]


# Device Settings
# -------------------------------
# This is where CoolerControl will save device settings for the cooresponding device.
# Settings can be set here also specifically by hand. (restart required for applying)
# These settings are applied on startup and each is overwritten once a new setting
# has been applied.
# Example:
# [device-settings.4b9cd1bc5fb2921253e6b7dd5b1b011086ea529d915a86b3560c236084452807]
# pump = { speed_fixed = 30 }
# logo = { lighting = { mode = "fixed", colors = [[0, 255, 255]] } }
# ring = { lighting = { mode = "spectrum-wave", backward = true, colors = [] } }
[device-settings]

[device-settings.4918af169e08d2fd42d3623dd3054933a5c772ba41b11d19abea089b9161853b]
fan1 = { profile_uid = "583c7d56-fad9-46ff-a112-e3152ff503e1" }
fan2 = { profile_uid = "583c7d56-fad9-46ff-a112-e3152ff503e1" }
fan3 = { profile_uid = "583c7d56-fad9-46ff-a112-e3152ff503e1" }
fan6 = { profile_uid = "a63253b1-a048-4aff-92b7-48b420e7ed25" }


# A list of profiles to be used with each device's settings
# -------------------------------
[[profiles]]
uid = "0"
name = "Unmanaged"
p_type = "Default"
function = "0"

[[profiles]]
uid = "a63253b1-a048-4aff-92b7-48b420e7ed25"
name = "GPU"
p_type = "Graph"
function_uid = "2576e942-2175-4e99-8a7d-2f373d72e05a"
speed_profile = [[20.0, 26], [60.0, 26], [65.0, 40], [100.0, 40]]
temp_source = { temp_name = "GPU Temp", device_uid = "b6d02588487877ec3238ea90ec100fdbb64c4a4bd72a37fcaf8961bbe9f9741f" }

[[profiles]]
uid = "67b1dd0f-330f-47cb-92ca-5d40ae48d81a"
name = "CPU"
p_type = "Graph"
function_uid = "2576e942-2175-4e99-8a7d-2f373d72e05a"
speed_profile = [[20.0, 20], [70.0, 20], [80.0, 50], [100.0, 50]]
temp_source = { temp_name = "temp1", device_uid = "3145e1a42801faf9cf948df8c705afb4859f084c10a7e7c5e4efecb1e0167127" }

[[profiles]]
uid = "583c7d56-fad9-46ff-a112-e3152ff503e1"
name = "Main Mix"
p_type = "Mix"
function_uid = "0"
member_profile_uids = ["a63253b1-a048-4aff-92b7-48b420e7ed25", "67b1dd0f-330f-47cb-92ca-5d40ae48d81a"]
mix_function_type = "Max"

# A list of functions to be applied to the various profiles
# -------------------------------
[[functions]]
uid = "0"
name = "Default Function"
f_type = "Identity"

[[functions]]
uid = "2576e942-2175-4e99-8a7d-2f373d72e05a"
name = "FanControl Hysteresis"
f_type = "Standard"
duty_minimum = 1
duty_maximum = 100
step_size_min_decreasing = 0
step_size_max_decreasing = 0
response_delay = 1
deviance = 2.0
only_downward = false
threshold_hopping = true
bypass_min_at_extremes = true


# Cooler Control Settings
# -------------------------------
# This is where CoolerControl specifc general and specifc device settings are set. These device
# settings differ from the above Device Settings, in that they are applied to CoolerControl,
# and not on the devices themselves. For ex. settings such as disabling/enabling a particular device.
[settings]

# whether to apply the saved device settings on daemon startup
apply_on_boot = true

# Whether to enable the integration with liquidctl.
# Disabling this will prevent any communication with liquidctl,
# and all HWMon supported devices will be shown.
liquidctl_integration = true

# There are some devices that are supported both by liquidctl and hwmon drivers. Normally the
# preference is to use liquidctl as it supports more features such as RGB control. There are
# some cases where the hwmon driver is preferred though. Note: Care should be taken to blacklist
# one of the devices to avoid needlessly loading the device IO and avoid concurrency issues.
# Use at your own risk.
hide_duplicate_devices = true

# Will skip initialization calls for liquidctl devices. ONLY USE if you are doing initialiation manually.
no_init = false

# Startup Delay (seconds) is an integer value between 0 and 120
startup_delay = 2

# For ThinkPads, wheather to use the 'full-speed' option when settings the fan to 100%
# This option drives the fan as fast as it can go, which might exceed hardware limits,
# so use this level with caution.
thinkpad_full_speed = false

# API Address and Port:
# The daemon by default uses port 11987 and the standard loopback IPv4 and IPv6 addresses.
# You can set an IPv4, IPv6 or both addresses to listen on. An empty string will disable the address.
# It is highly recommended to use the default settings unless you have a specific reason to change them
# and understand the implications.
# If you expose the API to a public network, it is recommended to use TLS/HTTPS (see below).
# For more information see the project wiki.
# Example:
# port = 11987
# ipv4_address = "127.0.0.1"
# ipv6_address = "::1"

# Whether to compress the response payload from the API. This will reduce the size of the response
# but will increase CPU usage a tiny bit. This is useful if you are running the API over a network.
# 'compress' is deprecated, use compress_payload instead.
compress_payload = true

# The polling rate for sensor data collection. The default is 1.0 second. Limited to values
# between 0.5 and 5.0 seconds in half-second increments.
# Note: Caution should be used when using values less than 1.0.
# poll_rate = 1.0

# Whether to check if drivetemp supported drives are in a suspended state/spun down, and if so,
# return 0C as their reporting temperature.
drivetemp_suspend = false

# TLS/HTTPS Configuration:
# TLS to secure the REST API with HTTPS. (enabled by default)
# When enabled, a self-signed certificate will be automatically generated on first startup if no
# certificate paths are specified. The certificate and key are stored in /etc/coolercontrol/ by
# default.
# Note: Self-signed certificates will cause browser warnings. You can provide your own
# certificate by specifying the paths below, or use a reverse proxy (nginx, caddy, traefik)
# to handle TLS termination as an alternative approach.
# tls_enabled = true
# tls_cert_path = "/etc/coolercontrol/coolercontrol.crt"
# tls_key_path = "/etc/coolercontrol/coolercontrol.key"

# Reverse Proxy / CORS Configuration:
# Custom origins to allow in CORS requests. This is useful when accessing CoolerControl through
# a reverse proxy with a custom domain, or via port forwarding with a public IP. Add the full
# origin URL (scheme + host + port if non-standard).
# origins = ["https://coolercontrol.mydomain.com", "http://192.168.1.1:8080"]

# Header to check for the client's original protocol when behind a reverse proxy. Common values
# are "X-Forwarded-Proto" (nginx, Apache) or "X-Scheme". When this header indicates "https",
# the HTTP-to-HTTPS redirect is skipped (the proxy handles TLS termination).
# protocol_header = "X-Forwarded-Proto"

# Allow unencrypted HTTP connections from non-localhost addresses. By default, non-localhost
# HTTP requests are redirected to HTTPS when TLS is enabled. Set this to true to allow HTTP.
# Note: This should only be used as a last resort and is not recommended.
# allow_unencrypted = false

# Whether to auto-detect Super-I/O hardware sensors and load the appropriate kernel
# modules at startup. This helps ensure all hwmon chips are available. (x86_64 only)
# sensors_auto_detect = true

# Whether to apply the "label" and "ignore" statements from the lm-sensors configuration files
# (/etc/sensors3.conf, /etc/sensors.conf and /etc/sensors.d/). Labels set there replace the ones
# the kernel driver reports, and ignored sensors are hidden. Names set in CoolerControl itself
# always win. The files are read once at startup and are never written to.
# sensors_conf_enabled = true

# Whether to listen for kernel device add/remove events (e.g. USB hotplug) at startup.
# When enabled, the daemon watches for hardware changes and notifies connected clients.
# Disable this in containers or environments without netlink socket access.
# device_listener_enabled = true

# Power profile to Mode mapping:
# When the system power profile changes, CoolerControl activates the Mode mapped to the new
# profile. The profile is read over D-Bus from power-profiles-daemon or the tuned-ppd shim;
# TLP does not expose one. Profiles left unmapped are ignored, and the mapping is also editable
# from the Modes page in the UI. Every change is published on the SSE "system" event whether or
# not a Mode is mapped.
# [power_profile_modes]
# power-saver = "<mode uid>"
# balanced = "<mode uid>"
# performance = "<mode uid>"

# CoolerControl Device settings Example:
# [settings.4b9cd1bc5fb2921253e6b7dd5b1b011086ea529d915a86b3560c236084452807]
# disabled = true
